<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#c91624">
    <link rel="icon" type="image/webp" href="{{ base_url }}assets/saku-wni-logo.webp">
    <title>{% block title %}Saku WNI{% endblock %}</title>
    <style nonce="{{ csp_nonce }}">
        :root {
            --red: #c91624;
            --red-dark: #8f0d18;
            --ink: #251b1c;
            --muted: #715e60;
            --paper: #fffdf8;
            --cream: #f4eee7;
            --line: #e8d8d3;
            --white: #ffffff;
            --shadow: 0 24px 70px rgba(96, 20, 25, 0.14);
        }
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            margin: 0;
            min-height: 100vh;
            color: var(--ink);
            background: var(--paper);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            line-height: 1.55;
        }
        a { color: inherit; text-decoration: none; }
        img { max-width: 100%; display: block; }
        .site-header {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            max-width: 1180px;
            margin: 0 auto;
            padding: 1.1rem 1.5rem;
        }
        .brand {
            display: inline-flex;
            align-items: center;
            gap: .72rem;
            font-weight: 850;
            letter-spacing: -.03em;
            font-size: 1.05rem;
        }
        .brand img {
            width: 42px;
            height: 42px;
            object-fit: cover;
            border-radius: 12px;
            border: 2px solid var(--white);
            box-shadow: 0 5px 15px rgba(143, 13, 24, .16);
        }
        .brand span { color: var(--red-dark); }
        .site-nav {
            display: flex;
            align-items: center;
            gap: 1.2rem;
            color: var(--muted);
            font-size: .9rem;
            font-weight: 700;
        }
        .site-nav a:hover { color: var(--red); }
        .nav-cta {
            padding: .62rem .9rem;
            color: var(--white) !important;
            background: var(--red);
            border-radius: 7px;
            box-shadow: 0 8px 18px rgba(201, 22, 36, .18);
        }
        .nav-cta:hover { background: var(--red-dark); }
        main { min-height: calc(100vh - 78px); }
        .page-wrap { overflow: hidden; }
        .container {
            width: min(1180px, calc(100% - 3rem));
            margin: 0 auto;
        }
        .hero {
            position: relative;
            overflow: hidden;
            min-height: 650px;
            display: flex;
            align-items: center;
            padding: 4.5rem 0 5.2rem;
            background: var(--red);
            color: var(--white);
            isolation: isolate;
        }
        .hero::after {
            content: "";
            position: absolute;
            z-index: -1;
            right: -6%;
            bottom: -18%;
            width: 68%;
            height: 54%;
            background: var(--paper);
            border-radius: 42% 0 0 0;
            transform: rotate(-5deg);
        }
        .hero-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.05fr) minmax(320px, .95fr);
            align-items: center;
            gap: 4rem;
        }
        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: .55rem;
            margin: 0 0 1.2rem;
            color: #ffd9da;
            font-size: .76rem;
            font-weight: 850;
            letter-spacing: .13em;
            text-transform: uppercase;
        }
        .eyebrow::before {
            content: "";
            width: 28px;
            height: 3px;
            background: #ffd9da;
            border-radius: 2px;
        }
        h1, h2, p { margin-top: 0; }
        h1 {
            max-width: 720px;
            margin-bottom: 1.2rem;
            font-size: clamp(3.2rem, 7vw, 6.7rem);
            line-height: .92;
            letter-spacing: -.075em;
        }
        .hero-copy {
            max-width: 610px;
            margin-bottom: 2rem;
            color: #ffe8e7;
            font-size: clamp(1.05rem, 2vw, 1.3rem);
        }
        .hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: .8rem;
        }
        .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 46px;
            padding: .72rem 1rem;
            border: 1px solid transparent;
            border-radius: 7px;
            font-size: .92rem;
            font-weight: 800;
            transition: transform .18s ease, background .18s ease, border-color .18s ease;
        }
        .button:hover { transform: translateY(-2px); }
        .button-primary { color: var(--red-dark); background: var(--white); }
        .button-primary:hover { background: #fff5f1; }
        .button-ghost { color: var(--white); border-color: rgba(255,255,255,.48); }
        .button-ghost:hover { border-color: var(--white); background: rgba(255,255,255,.1); }
        .hero-art {
            position: relative;
            display: grid;
            place-items: center;
            min-height: 400px;
        }
        .hero-art::before {
            content: "";
            position: absolute;
            inset: 9% 2% 4% 7%;
            background: var(--red-dark);
            border-radius: 48% 12% 42% 18%;
            transform: rotate(7deg);
        }
        .hero-art::after {
            content: "";
            position: absolute;
            top: 4%;
            right: 0;
            width: 110px;
            height: 110px;
            border: 18px solid #f3b9b8;
            border-left-color: transparent;
            border-bottom-color: transparent;
            border-radius: 50%;
            transform: rotate(18deg);
        }
        .logo-frame {
            position: relative;
            z-index: 1;
            width: min(390px, 78vw);
            aspect-ratio: 1;
            padding: 1.05rem;
            background: var(--paper);
            border: 10px solid rgba(255,255,255,.84);
            border-radius: 36px;
            box-shadow: var(--shadow);
            transform: rotate(-4deg);
        }
        .logo-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 22px;
        }
        .section {
            padding: 5.5rem 0;
            background: var(--paper);
        }
        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 2rem;
            margin-bottom: 2rem;
        }
        .section-heading h2 {
            max-width: 650px;
            margin-bottom: 0;
            color: var(--red-dark);
            font-size: clamp(2rem, 4vw, 3.3rem);
            line-height: 1;
            letter-spacing: -.055em;
        }
        .section-heading p {
            max-width: 360px;
            margin-bottom: .15rem;
            color: var(--muted);
        }
        .feature-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
        }
        .feature {
            padding: 1.5rem;
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--white);
        }
        .feature-mark {
            display: inline-grid;
            place-items: center;
            width: 42px;
            height: 42px;
            margin-bottom: 1.5rem;
            color: var(--white);
            background: var(--red);
            border-radius: 50%;
            font-weight: 900;
        }
        .feature h3 { margin: 0 0 .45rem; font-size: 1.1rem; }
        .feature p { margin-bottom: 0; color: var(--muted); font-size: .94rem; }
        .api-band {
            padding: 4rem 0;
            color: var(--white);
            background: var(--ink);
        }
        .api-band-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 2rem;
        }
        .api-band h2 { margin-bottom: .5rem; font-size: clamp(1.7rem, 3vw, 2.7rem); letter-spacing: -.05em; }
        .api-band p { margin-bottom: 0; color: #e8d8d6; }
        .api-actions { display: flex; flex-wrap: wrap; gap: .7rem; }
        .site-footer {
            padding: 1.2rem 0;
            color: var(--muted);
            background: var(--cream);
            font-size: .82rem;
        }
        .site-footer-inner {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
        }
        @media (max-width: 820px) {
            .hero { min-height: auto; padding: 3.6rem 0 4.7rem; }
            .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
            .hero-art { min-height: 330px; }
            .feature-grid { grid-template-columns: 1fr; }
            .section-heading, .api-band-inner { display: block; }
            .section-heading p { margin-top: 1rem; }
            .api-actions { margin-top: 1.5rem; }
        }
        @media (max-width: 560px) {
            .container { width: min(100% - 2rem, 1180px); }
            .site-header { padding: .85rem 1rem; }
            .site-nav a:not(.nav-cta) { display: none; }
            h1 { font-size: clamp(3.25rem, 17vw, 5rem); }
            .hero-art { min-height: 280px; }
            .logo-frame { width: min(310px, 82vw); border-width: 7px; border-radius: 26px; }
            .section { padding: 4rem 0; }
            .site-footer-inner { display: block; }
        }
    </style>
    {% block head %}{% endblock %}
</head>
<body>
    {% block page %}
        <header class="site-header">
            <a class="brand" href="{{ base_url }}">
                <img src="{{ base_url }}assets/saku-wni-logo.webp" alt="Logo Saku WNI">
                <span>Saku WNI</span>
            </a>
            <nav class="site-nav" aria-label="Navigasi utama">
                <a href="#fitur">Fitur</a>
                <a href="#api">API</a>
                <a class="nav-cta" href="{{ base_url }}docs">Buka Swagger</a>
            </nav>
        </header>
        <main>{% block body %}{% endblock %}</main>
        <footer class="site-footer">
            <div class="container site-footer-inner">
                <span>Saku WNI · Asisten finansial untuk WNI Simulator</span>
                <span>Backend API · {{ app_env }}</span>
            </div>
        </footer>
    {% endblock %}
</body>
</html>
