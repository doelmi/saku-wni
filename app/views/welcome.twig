{% extends 'layout.twig' %}

{% block title %}Saku WNI — Asisten Finansial WNI Simulator{% endblock %}

{% block body %}
<div class="page-wrap">
    <section class="hero">
        <div class="container hero-grid">
            <div>
                <p class="eyebrow">Pendamping resmi? Bukan. Berguna? Jelas.</p>
                <h1>Saku WNI</h1>
                <p class="hero-copy">
                    Asisten finansial untuk WNI Simulator. Catat uang negara,
                    kelola peserta, dan biarkan API mengurus hitung-hitungan
                    yang biasanya bikin meja permainan penuh coretan.
                </p>
                <div class="hero-actions">
                    <a class="button button-primary" href="{{ base_url }}docs">Coba API di Swagger</a>
                    <a class="button button-ghost" href="#fitur">Lihat yang bisa dilakukan</a>
                </div>
            </div>
            <div class="hero-art" aria-label="Logo Saku WNI">
                <div class="logo-frame">
                    <img src="{{ base_url }}assets/saku-wni-logo.webp" alt="Logo Saku WNI">
                </div>
            </div>
        </div>
    </section>

    <section class="section" id="fitur">
        <div class="container">
            <div class="section-heading">
                <h2>Urusan duit jadi lebih tertib.</h2>
                <p>
                    Dibuat untuk permainan yang ramai, transaksi yang cepat,
                    dan keputusan yang tidak perlu dicari lagi di balik kertas.
                </p>
            </div>
            <div class="feature-grid">
                <article class="feature">
                    <span class="feature-mark">01</span>
                    <h3>Game dan peserta</h3>
                    <p>Buat game, tambahkan peserta, atur status, dan lihat saldo masing-masing.</p>
                </article>
                <article class="feature">
                    <span class="feature-mark">02</span>
                    <h3>Transfer tercatat</h3>
                    <p>Uang bisa berpindah antar peserta dan setiap transaksi tersimpan di history.</p>
                </article>
                <article class="feature">
                    <span class="feature-mark">03</span>
                    <h3>Akses publik aman</h3>
                    <p>Bagikan token unik peserta untuk melihat saldo dan riwayat tanpa login.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="api-band" id="api">
        <div class="container api-band-inner">
            <div>
                <h2>Backend siap diajak main.</h2>
                <p>Semua endpoint tersedia dalam JSON dan bisa dicoba langsung lewat dokumentasi interaktif.</p>
            </div>
            <div class="api-actions">
                <a class="button button-primary" href="{{ base_url }}docs">Buka Swagger UI</a>
                <a class="button button-ghost" href="{{ base_url }}api/openapi">Lihat OpenAPI</a>
            </div>
        </div>
    </section>
</div>
{% endblock %}
