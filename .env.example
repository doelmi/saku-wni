# Application
APP_ENV=development
APP_DEBUG=true
FLIGHT_BASE_URL=/
APP_TIMEZONE=UTC

# Database — env wins over config.php for these keys when set
# Drivers: sqlite | mysql | (empty to disable)
DB_DRIVER=sqlite
DB_HOST=localhost
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Absolute or project-relative path for SQLite
DB_SQLITE_PATH=

# SMTP email for authentication OTP
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=15
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Saku WNI
MAIL_OTP_SUBJECT=Your login verification code
