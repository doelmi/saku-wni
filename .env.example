# Application
APP_ENV=development
APP_DEBUG=true
FLIGHT_BASE_URL=/
APP_TIMEZONE=UTC

# Origin frontend yang boleh mengakses API, pisahkan dengan koma jika lebih dari satu
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database — env wins over config.php for these keys when set
# Drivers: sqlite | mysql | (empty to disable)
DB_DRIVER=sqlite
DB_HOST=localhost
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Absolute or project-relative path for SQLite
DB_SQLITE_PATH=

# Maksimal game baru per pengguna per hari (mengikuti APP_TIMEZONE)
GAMES_DAILY_CREATE_LIMIT=5
# Maksimal game baru dari semua pengguna per hari (mengikuti APP_TIMEZONE)
GAMES_GLOBAL_DAILY_CREATE_LIMIT=100
# Maksimal peserta tambahan baru per game per hari (mengikuti APP_TIMEZONE)
PARTICIPANTS_DAILY_CREATE_LIMIT=10
# Maksimal email OTP yang boleh dikirim ke semua user per hari
AUTH_DAILY_EMAIL_LIMIT=200
# Maksimal total transfer per game
TRANSFERS_PER_GAME_LIMIT=10000

# SMTP email for authentication OTP
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=15
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Saku WNI
MAIL_OTP_SUBJECT=Kode verifikasi login kamu

# Server-Sent Events
SSE_MAX_DURATION=55
SSE_POLL_INTERVAL=2
SSE_RETRY_AFTER=3000
